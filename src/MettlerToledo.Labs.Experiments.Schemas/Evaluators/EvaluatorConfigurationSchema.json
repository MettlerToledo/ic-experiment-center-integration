{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/evaluators/evaluatorConfiguration",
  "title": "Defines an evaluator configuration for a piece of equipment",

  "type": "object",

  "properties": {
    "name": {
      "type": "string"
    },
    "trends": {
      "type": "array",
      "items": {
        "anyOf": [
          { "$ref": "/schemas/experiments/evaluators/peakDefinition" },
          { "$ref": "/schemas/experiments/evaluators/statisticDefinition" },
          { "$ref": "/schemas/experiments/evaluators/trendDefinition" }
        ]
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "/schemas/experiments/evaluators/evaluatorParameter"
      }
    }
  },
  "unevaluatedProperties": false
}
