{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/evaluators/trendDefinitionBase",
  "title": "Defines the common properties of a trend definition for an evaluator configuration",

  "type": "object",

  "properties": {
    "name": {
      "type": "string"
    },
    "units": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "description": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "/schemas/experiments/evaluators/evaluatorParameter"
      }
    }
  }
}
