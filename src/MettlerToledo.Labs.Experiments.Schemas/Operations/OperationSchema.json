{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/operations/operation",
  "title": "Defines the data for all operations",

  "type": "object",

  "properties": {
    "trackingId": {
      "$ref": "/schemas/experiments/trackingId"
    },
    "startTimeUtc": {
      "type": [ "string", "null" ],
      "format": "date-time"
    },
    "startTimeRelative": {
      "type": [ "string", "null" ],
      "format": "duration"
    },
    "completionTimeUtc": {
      "type": [ "string", "null" ],
      "format": "date-time"
    },
    "completionTimeRelative": {
      "type": [ "string", "null" ],
      "format": "duration"
    },
    "completionStatus": {
      "anyOf": [
        {
          "type": "string",
          "enum": [ "Complete", "Aborted" ]
        },
        {
          "type": "null"
        }
      ]
    },
    "peripherals": {
      "type": "array",
      "items": {
        "$ref": "/schemas/experiments/equipment/equipmentReference"
      }
    },
    "equipment": {
      "anyOf": [
        {
          "$ref": "/schemas/experiments/equipment/equipmentReference"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
