{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/operations/controlBalanceOperation",
  "title": "Defines the data for a control balance operation",

  "type": "object",

  "$ref": "/schemas/experiments/operations/operation",
  "properties": {
    "$type": {
      "const": "ControlBalanceOperation"
    },
    "parameters": {
      "type": "object",
      "anyOf": [
        { "$ref": "#/definitions/controlBalanceOnParameters" },
        { "$ref": "#/definitions/controlBalanceOffParameters" }
      ]
    }
  },
  "unevaluatedProperties": false,
  "definitions": {
    "controlBalanceOnParameters": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "ControlBalanceOnParameters"
        },
        "material": {
          "anyOf": [
            {
              "$ref": "/schemas/experiments/materials/materialPortionReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "waitForStable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "controlBalanceOffParameters": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "ControlBalanceOffParameters"
        }
      },
      "additionalProperties": false
    }
  }
}
