{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/operations/agitateOperation",
  "title": "Defines the data for an agitate operation",

  "type": "object",

  "$ref": "/schemas/experiments/operations/operation",
  "properties": {
    "$type": {
      "const": "AgitateOperation"
    },
    "parameters": {
      "type": "object",
      "anyOf": [
        { "$ref": "#/definitions/stirParameters" },
        { "$ref": "#/definitions/shakeParameters" },
        { "$ref": "#/definitions/vortexParameters" },
        { "$ref": "#/definitions/swirlParameters" },
        { "$ref": "#/definitions/sonicParameters" }
      ]
    }
  },
  "unevaluatedProperties": false,
  "definitions": {
    "stirParameters": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "StirParameters"
        },
        "stirrerType": {
          "anyOf": [
            {
              "type": "string",
              "enum": [ "Magnetic", "Overhead" ]
            },
            {
              "type": "null"
            }
          ]
        },
        "speed": {
          "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/rotationalFrequency"
        },
        "duration": {
          "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/time"
        }
      },
      "additionalProperties": false
    },
    "shakeParameters": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "ShakeParameters"
        },
        "speed": {
          "anyOf": [
            { "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/rotationalFrequency" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "vortexParameters": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "VortexParameters"
        },
        "speed": {
          "anyOf": [
            { "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/rotationalFrequency" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "swirlParameters": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "SwirlParameters"
        }
      },
      "additionalProperties": false
    },
    "sonicParameters": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "SonicParameters"
        }
      },
      "additionalProperties": false
    }
  }
}
