{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/operations/sampleOperation",
  "title": "Defines the data for a sampler operation",

  "type": "object",

  "$ref": "/schemas/experiments/operations/operation",

  "properties": {
    "$type": {
      "const": "SampleOperation"
    },
    "sampleTimeUtc": {
      "type": [ "string", "null" ],
      "format": "date-time"
    },
    "parameters": {
      "type": "object",
      "anyOf": [
        { "$ref": "#/definitions/singlsSampleParameters" },
        { "$ref": "#/definitions/sequenceSampleParameters" }
      ]
    },
    "collectedSamples": {
      "type": "array",
      "items": {
        "type": "object",
        "anyOf": [
          { "$ref": "/schemas/experiments/samples/sample" }
        ]
      }
    }
  },
  "unevaluatedProperties": false,
  "definitions": {
    "singlsSampleParameters": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "SingleSampleParameters"
        },
        "sampleId": { "type": "string" },
        "alternateName": { "type": "string" },
        "preparation": { "type": "string" },
        "quantity": {
          "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/chemicalAmount"
        },
        "dilutionFactor": {
          "$ref": "/schemas/experiments/parameters/unitValueParameter"
        }
      },
      "additionalProperties": false
    },
    "sequenceSampleParameters": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "SequenceSampleParameters"
        },
        "preparation": { "type": "string" },
        "sequenceName": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
