{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/operations/releaseOperation",
  "title": "Defines the data for a release operation",

  "type": "object",

  "$ref": "/schemas/experiments/operations/operation",
  "properties": {
    "$type": {
      "const": "ReleaseOperation"
    },
    "parameters": {
      "type": "object",
      "anyOf": [
        { "$ref": "#/definitions/releaseParametersDefined" },
        { "$ref": "#/definitions/releaseParametersCurrent" }
      ]
    }
  },
  "unevaluatedProperties": false,
  "definitions": {
    "releaseParametersDefined": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "ReleaseParametersDefined"
        },
        "temperature": {
          "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/temperature"
        },
        "stirringSpeed": {
          "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/rotationalFrequency"
        }
      },
      "additionalProperties": false
    },
    "releaseParametersCurrent": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "ReleaseParametersCurrent"
        }
      },
      "additionalProperties": false
    }
  }
}
