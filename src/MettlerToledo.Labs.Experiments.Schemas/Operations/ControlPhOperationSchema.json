{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/operations/controlPhOperation",
  "title": "Defines the data for a control pH operation",

  "type": "object",

  "$ref": "/schemas/experiments/operations/operation",
  "properties": {
    "$type": {
      "const": "ControlPhOperation"
    },
    "parameters": {
      "type": "object",
      "anyOf": [
        { "$ref": "#/definitions/controlPhParametersRampByRate" },
        { "$ref": "#/definitions/controlPhParametersHoldActual" },
        { "$ref": "#/definitions/controlPhParametersSwitchOff" }
      ]
    }
  },
  "unevaluatedProperties": false,
  "definitions": {
    "controlPhParameters": {
      "type": "object",
      "properties": {
        "dosingType": {
          "type": "string",
          "enum": [ "Acid", "Base" ]
        },
        "material": {
          "anyOf": [
            {
              "$ref": "/schemas/experiments/materials/materialPortionReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "mixingTime": {
          "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/time"
        },
        "minPhDeviation": {
          "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/ph"
        },
        "phStabilityRate": {
          "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/phRate"
        },
        "maxChargedQuantity": {
          "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/chemicalAmount"
        }
      }
    },
    "controlPhParametersRampByRate": {
      "type": "object",
      "$ref": "#/definitions/controlPhParameters",
      "properties": {
        "$type": {
          "const": "ControlPhParametersRampByRate"
        },
        "ph": {
          "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/ph"
        },
        "rate": {
          "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/phRate"
        }
      },
      "unevaluatedProperties": false
    },
    "controlPhParametersHoldActual": {
      "type": "object",
      "$ref": "#/definitions/controlPhParameters",
      "properties": {
        "$type": {
          "const": "ControlPhParametersHoldActual"
        }
      },
      "unevaluatedProperties": false
    },
    "controlPhParametersSwitchOff": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "ControlPhParametersSwitchOff"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
