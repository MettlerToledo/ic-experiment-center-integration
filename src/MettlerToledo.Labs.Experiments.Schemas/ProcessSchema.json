{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/process",
  "title": "Defines the data of a process",

  "type": "object",

  "properties": {
    "trackingId": {
      "$ref": "/schemas/experiments/trackingId"
    },
    "processType": {
      "type": "string",
      "enum": [ "None", "Synthesis", "Rework", "Reprocess", "Purification", "ParticleTuning" ]
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "/schemas/experiments/stage"
      }
    }
  },
  "additionalProperties": false
}
