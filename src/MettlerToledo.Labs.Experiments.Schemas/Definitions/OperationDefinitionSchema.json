{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/operationDefinition",
  "title": "Defines an operation definition",

  "type": "object",

  "$ref": "/schemas/experiments/s88Definition",
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "ControlPH",
        "Charge",
        "TemperatureControl",
        "HfCalDetermination",
        "OperatorMessage",
        "Pause",
        "QuickCalDetermination",
        "RecordVirtualVolume",
        "ResetIntegralQrRtc",
        "RTCalDetermination",
        "Settle",
        "Agitate",
        "TakeSample",
        "TakePicture",
        "Observation",
        "Wait",
        "Centrifuge",
        "Chromatography",
        "Concentrate",
        "Discharge",
        "Dry",
        "Filter",
        "Homogenize",
        "Hydrocyclone",
        "Inert",
        "Mill",
        "PackAndLabel",
        "PressureAdjust",
        "Recirculate",
        "Rinse",
        "Separate",
        "Sieve",
        "Transfer",
        "Wash",
        "WetMill"
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "anyOf": [
          { "$ref": "/schemas/experiments/parameters/booleanParameterDefinition" },
          { "$ref": "/schemas/experiments/parameters/materialParameterDefinition" },
          { "$ref": "/schemas/experiments/parameters/stringParameterDefinition" },
          { "$ref": "/schemas/experiments/parameters/unitValueParameterDefinition" }
        ]
      }
    }
  },
  "unevaluatedProperties": false,
  "required": ["id"]
}
