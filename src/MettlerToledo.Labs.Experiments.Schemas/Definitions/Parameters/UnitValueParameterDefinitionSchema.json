{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/parameters/unitValueParameterDefinition",
  "title": "Defines a unit value parameter definition",

  "type": "object",

  "$ref": "/schemas/experiments/parameters/dynamicParameterDefinition",
  "properties": {
    "$type": {
      "const": "UnitValueParameterDefinition"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "minimumValue": {
      "anyOf": [
        {
          "$ref": "/schemas/experiments/unitValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "maximumValue": {
      "anyOf": [
        {
          "$ref": "/schemas/experiments/unitValue"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "unevaluatedProperties": false
}
