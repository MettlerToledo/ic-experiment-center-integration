{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/materials/materialPortion",
  "title": "Defines the data for a material portion",

  "type": "object",

  "properties": {
    "trackingId": {
      "$ref": "/schemas/experiments/trackingId"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [ "Undefined", "LimitingReactant", "Reactant", "Catalyst", "Solvent", "QuenchMaterial", "Intermediate", "ByProduct", "Product", "Other" ]
    },
    "lotNumber": {
      "type": "string"
    },
    "density": {
      "anyOf": [
        {
          "$ref": "/schemas/experiments/unitValue#/definitions/density"
        },
        {
          "type": "null"
        }
      ]
    },
    "quantity": {
      "$ref": "/schemas/experiments/parameters/unitValueParameter#/definitions/chemicalAmount"
    }
  },
  "additionalProperties": false
}
