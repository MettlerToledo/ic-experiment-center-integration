{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/parameters/dynamicMaterialReferenceParameter",
  "type": "object",

  "$ref": "/schemas/experiments/parameters/dynamicParameter",
  "properties": {
    "$type": {
      "const": "MaterialReference"
    },
    "material": {
      "anyOf": [
        {
