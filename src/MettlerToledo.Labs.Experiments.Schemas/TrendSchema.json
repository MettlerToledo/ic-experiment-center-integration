{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/trend",
  "title": "Trend schema",

  "type": "object",

  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the trend."
    },
    "unit": {
      "type": "string",
      "description": "The unit for the trend."
    },
    "startTimeUtc": {
      "type": "string",
      "format": "date-time",
      "description": "The start time of the trend in UTC."
    },
    "values": {
      "type": "array",
      "description": "An array of time offset and values.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "format": "duration"
          },
          "v": { "type": "number" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
