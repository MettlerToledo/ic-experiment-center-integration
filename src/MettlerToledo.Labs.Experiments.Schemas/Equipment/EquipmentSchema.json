{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/equipment/equipment",
  "title": "Defines the data for equipment used in an experiment",

  "type": "object",

  "properties": {
    "trackingId": {
      "$ref": "/schemas/experiments/trackingId"
    },
    "category": {
      "type": "string",
      "enum": [
        "Unknown",
        "Balance",
        "IR",
        "Alr",
        "VolumetricDosing",
        "Sampler",
        "GravimetricDosing",
        "Thermometer",
        "CalibrationHeater",
        "FinalControlElement",
        "LiquidPump",
        "Sensor"
      ]
    },
    "model": {
      "type": "string"
    },
    "serialNumber": {
      "type": "string"
    }
  },
  "required": [ "category" ]
}