{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://iC3ng.com/schemas/experiments/equipment/occpuation",
  "title": "Defines an occupation of a instrument zone for an experiment",

  "type": "object",

  "properties": {
    "trackingId": {
      "$ref": "/schemas/experiments/trackingId"
    },
    "startTimeUtc": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "releaseTimeUtc": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "trends": {
      "type": "array",
      "items": {
        "$ref": "/schemas/experiments/trend"
      }
    }
  },
  "additionalProperties": false
}
