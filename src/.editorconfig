#Don't use string interpolation in logging message templates
dotnet_diagnostic.S2629.severity = suggestion

# S6605: Collection-specific "Exists" method should be used instead of the "Any" extension
dotnet_diagnostic.S6605.severity = suggestion

# S6667: Logging in a catch clause should pass the caught exception as a parameter.
dotnet_diagnostic.S6667.severity = suggestion

# S6608: Prefer indexing instead of "Enumerable" methods on types implementing "IList"
dotnet_diagnostic.S6608.severity = none

# S6603: The collection-specific "TrueForAll" method should be used instead of the "All" extension
dotnet_diagnostic.S6603.severity = suggestion

# S6602: "Find" method should be used instead of the "FirstOrDefault" extension
dotnet_diagnostic.S6602.severity = suggestion

# S2955: Generic parameters not constrained to reference types should not be compared to "null"
dotnet_diagnostic.S2955.severity = suggestion

# S127: "for" loop stop conditions should be invariant
dotnet_diagnostic.S127.severity = suggestion

# S1244: Floating point numbers should not be tested for equality
dotnet_diagnostic.S1244.severity = suggestion

#MC3066: The type reference cannot find a public type 
dotnet_diagnostic.MC3066.severity = suggestion

#XDG0008 The name does not exist in the namespace 
dotnet_diagnostic.XDG0008.severity = suggestion

#S6672 Generic logger injection should match enclosing type
dotnet_diagnostic.S6672.severity = suggestion

#S2139 Exceptions should be either logged or rethrown but not both
dotnet_diagnostic.S2139.severity = suggestion

#S1144 Unused private types or members should be removed 
dotnet_diagnostic.S1144.severity = suggestion

#S1075 URIs should not be hardcoded
dotnet_diagnostic.S1075.severity = suggestion

#S6562 Always set the "DateTimeKind" when creating new "DateTime" instances
dotnet_diagnostic.S6562.severity = none

#S4158 Empty collections should not be accessed or iterated
dotnet_diagnostic.S4158.severity = none
